# Provider credentials (fill in the providers you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Runtime configuration
# Provider: anthropic | openai | gemini (auto-detected from keys when omitted)
SQUADRON_PROVIDER=
# Model identifier required by your provider account
SQUADRON_MODEL=
SQUADRON_MAX_STEPS=
SQUADRON_MAX_TOKENS=
# Optional path to an extra env file to load
SQUADRON_ENV_FILE=
